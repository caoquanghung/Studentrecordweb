# Clerk authentication. Required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL. Required in production.
DATABASE_URL=

# Development-only runnable adapter. Never enable in production.
STUDENTWEB_DEMO_MODE=true
STUDENTWEB_DEMO_ROLE=student

# Study policy. The confirmed reservation default is 30 minutes.
STUDY_RESERVATION_DURATION_SECONDS=1800
STUDY_HEARTBEAT_INTERVAL_SECONDS=5
STUDY_CONNECTION_TIMEOUT_SECONDS=20
STUDY_TELEMETRY_FLUSH_SECONDS=5
STUDY_PLAYBACK_SAMPLE_SECONDS=1
STUDY_MAX_BUFFERING_SECONDS=5
STUDY_ASSIGNMENT_MODE=development-stub

# Client-visible streaming calibration (not a secret).
NEXT_PUBLIC_STUDY_MIN_STREAM_MBPS=2

# Scheduled cleanup endpoint.
CRON_SECRET=
